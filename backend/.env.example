# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/canteenDB

# ---- Security ----
# REQUIRED. Generate a strong value with:  npm run generate:secret
# The server refuses to start in production if this is left at a known-weak default.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=300

# ---- Business rules ----
ORDER_MAX_QUANTITY=20
ORDER_MAX_ITEMS=30

# Phase 2 lifecycle. false (default) lets staff/admin skip ahead along the
# forward path (Pending -> Preparing, Pending -> Completed), preserving the
# original admin workflow. Set true to require every stage:
#   Pending -> Accepted -> Preparing -> Ready -> Completed
ORDER_STRICT_LIFECYCLE=false

# ---- Pickup slot capacity ----
# Orders each pickup slot can take. 0 means unlimited.
PICKUP_SLOT_CAPACITY=20

# ---- Kitchen estimates ----
# Orders the kitchen works on at once, for the estimated wait.
KITCHEN_PARALLEL_ORDERS=3
# How often waiting times are recalculated when nothing else changes.
KITCHEN_ETA_REFRESH_SECONDS=60

# ---- Notifications ----
# How often queued notifications are sent, and how many tries before giving up.
NOTIFY_DISPATCH_SECONDS=30
NOTIFY_MAX_ATTEMPTS=3

# Email (optional). Email is sent only if SMTP_HOST and SMTP_FROM are set AND
# the student has turned email on. Nothing is sent otherwise.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Canteen <no-reply@example.com>"

# Browser push (optional). Generate a key pair once, for example with
#   npx web-push generate-vapid-keys
# Push is sent only if all three are set AND the student has subscribed.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:canteen@example.com

# ---- Admin seed script (optional, used only by `npm run seed:admin`) ----
# ADMIN_EMAIL=head@college.edu
# ADMIN_NAME=Canteen Admin
# ADMIN_PASSWORD=
# ADMIN_ROLE=admin