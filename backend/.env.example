# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/canteenDB

# ---- Security ----
# REQUIRED. Generate a strong value with:  npm run generate:secret
# The server refuses to start in production if this is left at a known-weak default.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=300

# ---- Business rules ----
ORDER_MAX_QUANTITY=20
ORDER_MAX_ITEMS=30

# Phase 2 lifecycle. false (default) lets staff/admin skip ahead along the
# forward path (Pending -> Preparing, Pending -> Completed), preserving the
# original admin workflow. Set true to require every stage:
#   Pending -> Accepted -> Preparing -> Ready -> Completed
ORDER_STRICT_LIFECYCLE=false

# ---- Pickup slot capacity ----
# Orders each pickup slot can take. 0 means unlimited.
PICKUP_SLOT_CAPACITY=20

# ---- Kitchen estimates ----
# Orders the kitchen works on at once, for the estimated wait.
KITCHEN_PARALLEL_ORDERS=3
# How often waiting times are recalculated when nothing else changes.
KITCHEN_ETA_REFRESH_SECONDS=60

# ---- Notifications ----
# How often queued notifications are sent, and how many tries before giving up.
NOTIFY_DISPATCH_SECONDS=30
NOTIFY_MAX_ATTEMPTS=3

# Email (optional). Email is sent only if SMTP_HOST and SMTP_FROM are set AND
# the student has turned email on. Nothing is sent otherwise.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Canteen <no-reply@example.com>"

# Browser push (optional). Generate a key pair once, for example with
#   npx web-push generate-vapid-keys
# Push is sent only if all three are set AND the student has subscribed.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:canteen@example.com

# ---- Admin seed script (optional, used only by `npm run seed:admin`) ----
# ADMIN_EMAIL=head@college.edu
# ADMIN_NAME=Canteen Admin
# ADMIN_PASSWORD=
# ADMIN_ROLE=admin

# ---- Inventory ----
# When stock is physically deducted: "preparing" (default, when cooking starts)
# or "accepted" (when the kitchen accepts). Stock is always reserved at order
# time; cancelling after acceptance restocks only when this is "accepted".
INVENTORY_DEDUCT_AT=preparing

# ---- Menu meal periods (canteen-local time, HH:MM) ----
# Defaults: breakfast 06:00-11:00, lunch 11:00-15:00, snacks 15:00-18:00,
# dinner 18:00-22:00. Use the same clock as CANTEEN_UTC_OFFSET_MINUTES.
# MENU_BREAKFAST_FROM=06:00
# MENU_BREAKFAST_TO=11:00
# MENU_LUNCH_FROM=11:00
# MENU_LUNCH_TO=15:00
# MENU_SNACKS_FROM=15:00
# MENU_SNACKS_TO=18:00
# MENU_DINNER_FROM=18:00
# MENU_DINNER_TO=22:00

# ---- Menu image uploads ----
# Folder for uploaded menu photos (served at /uploads). Relative paths are
# resolved from the backend folder. Default: backend/uploads (git-ignored).
# UPLOAD_DIR=
# Largest accepted photo in bytes. Default 2 MB; clamped to 64 KB - 5 MB.
# Accepted types: JPEG, PNG, WebP (SVG is refused).
UPLOAD_MAX_BYTES=2097152
